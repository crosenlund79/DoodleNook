<Project>
  <!-- Shared settings for every DoodleNook project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.10.0</Version>
    <!-- The milestone shown in the window title ("DoodleNook — M009"). Change it here for the next mission. -->
    <DoodleNookMilestone>M010</DoodleNookMilestone>
    <Product>DoodleNook</Product>
    <Company>DoodleNook</Company>
    <Copyright>DoodleNook contributors</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Milestone" Value="$(DoodleNookMilestone)" />
  </ItemGroup>
</Project>
