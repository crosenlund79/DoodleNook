<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DoodleNook.App.App"
             Name="DoodleNook"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DoodleNook/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://DoodleNook/Theme/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://DoodleNook/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
