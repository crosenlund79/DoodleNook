<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DoodleNook.App.MainWindow"
        Title="DoodleNook"
        Icon="/Assets/DoodleNook.ico"
        Width="1280" Height="800" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <!--
    The five workspaces share this one window, one document and one canvas. The bars, docks and overlays are
    built in code (MainWindow.Workspaces.cs) and swapped into these hosts when the workspace changes; the
    document is never reloaded.
  -->
  <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto">
    <Border x:Name="TopHost" Grid.Row="0" />
    <Border x:Name="OptionsHost" Grid.Row="1" />
    <Grid x:Name="MainGrid" Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto">
      <Border x:Name="ToolHost" Grid.Column="0" />
      <Panel x:Name="CanvasHost" Grid.Column="1" Background="{DynamicResource DnSurround}" ClipToBounds="True" />
      <GridSplitter x:Name="DockSplitter" Grid.Column="2" Width="5" ResizeDirection="Columns" Background="Transparent"
                    ToolTip.Tip="Drag to make the panels wider or narrower" />
      <Border x:Name="RightHost" Grid.Column="3" />
    </Grid>
    <Border x:Name="BottomHost" Grid.Row="3" />

    <!-- ============ Dialogs ============ -->
    <Panel x:Name="DialogLayer" Grid.RowSpan="4" IsVisible="False" Background="{DynamicResource DnScrim}">
      <Border x:Name="DialogCard" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource DnUi2}" BorderBrush="{DynamicResource DnLine}" BorderThickness="1"
              CornerRadius="14" Padding="20,18" BoxShadow="{StaticResource DnPopShadow}" />
    </Panel>
  </Grid>
</Window>
